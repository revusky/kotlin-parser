DEFAULT_LEXICAL_STATE=KOTLIN;
DEACTIVATE_TOKENS = SHEBANG, NL;
TAB_SIZE=4;
ENSURE_FINAL_EOL;

INCLUDE "KotlinLexer.ccc"

KotlinFile :
  ACTIVATE_TOKENS SHEBANG NL [ShebangLine]
  (FileAnnotation)*
  [PackageDeclaration]
  (ImportDeclaration)*
  (TopLevelObject)*
  <EOF>
;

TopLevelObject : Declaration [Semis] ;

DottedName : <IDENTIFIER> ("." <IDENTIFIER> =>||)* ;

ShebangLine : <SHEBANG> <NL> ;

FileAnnotation :
   "@"
   ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))}
   =>||
   'file' ":"
    (
        "[" (UnescapedAnnotation)+ "]"
        |
        UnescapedAnnotation
    )
;

PackageDeclaration : "package" <IDENTIFIER> Semis ;

ImportDeclaration :
    'import'
    DottedName
    [
        "." "*"
        |
        "as" <IDENTIFIER>
    ]
    Semis
;

UnescapedAnnotation : UserType [ValueArguments #ConstructorInvocation(2)] ;

ConstructorInvocation : UserType ValueArguments;

UserType : SimpleUserType ("." SimpleUserType)* ;

SimpleUserType : <IDENTIFIER> [TypeArguments] ;

ValueArguments :
   "("
   [
      ValueArgument
      ("," =>|+1 ValueArgument)* [","]
   ]
   ")"
;

ValueArgument :
   [Annotation]
   [<IDENTIFIER> "=" =>||]
   ["*"]
   Expression
;

TypeArguments :
   "<"
   TypeProjection
   ("," =>|+1 TypeProjection)* [","]
   ">"
;

TypeProjection :
    "*"
    |
    TypeProjectionModifiers Type
;

TypeProjectionModifiers :
   ("in" | 'out' | Annotation)*
;

Annotation :
   (
    AnnotationUseSiteTarget
    |
    "@"
    ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))} =>||
   )
   (
      UnescapedAnnotation
      |
      "[" (UnescapedAnnotation)+ "]"
   )
;

AnnotationUseSiteTarget :
    "@"
    ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))}
    ('field' | 'property' | 'get' | 'set' | 'receiver' | 'param' | 'setparam' | 'delegate')
    =>||
    ":"
;

Type :
   [TypeModifiers]
   (
     FunctionType
     |
     DefinitelyNullableType
     |
     NullableType
   )
;

TypeModifiers :
   ('suspend' | Annotation)+
;

ParenthesizedType : "(" Type ")" ;

FunctionType :
   [ReceiverType "." =>||]
   FunctionTypeParameters
   "->" =>||
   Type
;

ReceiverType :
   [TypeModifiers]
   NullableType
;

NullableType :
   (TypeReference | ParenthesizedType)
   ("?")*
;

TypeReference : 'dynamic' | UserType ;

DefinitelyNullableType :
   [TypeModifiers]
   (UserType | ParenthesizedUserType)
   "&" =>||
   [TypeModifiers]
   (UserType | ParenthesizedUserType)
;

ParenthesizedUserType : "(" (UserType | ParenthesizedUserType) ")" ;

FunctionTypeParameters :
    "("
    [Parameter|Type]
    ("," =>|+1 (Parameter | Type))*
    [","]
    ")"
;

Parameter : <IDENTIFIER> ":" =>|| Type ;

#Expression#interface :
   Disjunction
   {return (Expression) peekNode();}
;

INJECT Disjunction : implements Expression
INJECT Conjunction : implements Expression
INJECT Equality : implements Expression
INJECT Comparison : implements Expression
INJECT GenericCallLikeComparison : implements Expression
INJECT InfixOperation : implements Expression
INJECT ElvisExpression : implements Expression
INJECT PostfixUnaryExpression : implements Expression

Disjunction : Conjunction ("||" Conjunction)* ;

Conjunction : Equality ("&&" Equality)* ;

Equality : Comparison (EqualityOperator Comparison)* ;

Comparison : GenericCallLikeComparison (ComparisonOperator GenericCallLikeComparison)* ;

GenericCallLikeComparison : InfixOperation (CallSuffix)* ;

InfixOperation : ElvisExpression ((InOperator ElvisExpression) | IsOperator Type)* ;

ElvisExpression : InfixFunctionCall ("?:" InfixFunctionCall)* ;

InfixFunctionCall : RangeExpression (<IDENTIFIER> RangeExpression)* ;

RangeExpression : AdditiveExpression ((".." | "..<") AdditiveExpression)* ;

AdditiveExpression : MultiplicativeExpression (("+"|"-") MultiplicativeExpression)* ;

MultiplicativeExpression : AsExpression (("*"|"/"|"%") AsExpression)* ;

AsExpression : PrefixUnaryExpression ("as" Type)* ;

PrefixUnaryExpression :
    (ENSURE {getTokenType(1) != IDENTIFIER || getTokenType(2) == AT_NO_WS} UnaryPrefix)*
    PostfixUnaryExpression
;

UnaryPrefix#void : Annotation | PrefixUnaryOperator | Label ;

PrefixUnaryOperator#void : "++" | "--" | "-" | "+" | "!" ;

PostfixUnaryExpression : PrimaryExpression (PostfixUnarySuffix)* ;

EqualityOperator#void : "!=" | "!==" | "==" | "===" ;

ComparisonOperator#void : "<" | "<=" | ">=" | ">" ;

// TODO: Need a token lexical action to deal with NOT_IN and NOT_IS
InOperator#void : "in" | "!in" ;

IsOperator#void : "is" | "!is";

Label : <IDENTIFIER> ENSURE {getToken(0).getEndOffset() == getToken(1).getBeginOffset() } "@" =>|| ;

PostfixUnarySuffix#void :
    PostfixUnaryOperator
    |
    CallSuffix
    |
    TypeArguments
    |
    IndexingSuffix
    |
    NavigationSuffix
;

PostfixUnaryOperator#void : "++" | "--" | "!" ;

NavigationSuffix : MemberAccessOperator (<IDENTIFIER> | ParenthesizedExpression | "class") ;

IndexingSuffix : "[" Expression ("," =>|+1 Expression)* [","] "]" ;

CallSuffix :
    [TypeArguments]
    =>|+1
    (
        AnnotatedLambda
        |
        ValueArguments [AnnotatedLambda]
    )
;

MemberAccessOperator :
   "."
   |
   "::"
   |
   "?"
   ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))}
   "."
   =>||
;

AnnotatedLambda : (Annotation)* [Label] LambdaLiteral ;

LambdaLiteral :
    "{"
    [
        [LambdaParameters] "->"
    ]
    Statements
    "}"
;

LambdaParameters :
   LambdaParameter ("," =>|+1 LambdaParameter)* [","]
;

LambdaParameter :
   VariableDeclaration
   |
   MultiVariableDeclaration [":" Type]
;

VariableDeclaration : (Annotation)* <IDENTIFIER> [":" Type] ;

MultiVariableDeclaration :
    "("
    VariableDeclaration
    ("," =>|+1 VariableDeclaration)* [","]
    ")"
;

Semis :
   ACTIVATE_TOKENS NL
    (";" | <NL>)+
;

Statements :
  [
    Statement
    (Semis =>|+1 Statement)*
    [Semis]
  ]
;

Statement :
   (Label|Annotation)*
   (
    Declaration
    |
    Assignment
    |
    ForStatement
    |
    WhileStatement
    |
    DoWhileStatement
    |
    Expression
   )
;

ForStatement :
   "for"
   "("
   (Annotation)*
   (MultiVariableDeclaration|VariableDeclaration)
   "in"
   Expression
   ")"
   [ControlStructureBody]
;

WhileStatement :
    "while"
    "("
    Expression
    ")"
    (ControlStructureBody | ";")
;

DoWhileStatement :
   "do"
   [ControlStructureBody]
   "while"
   "("
   Expression
   ")"
;

ControlStructureBody : Block | Statement ;

Block : "{" Statements "}" ;

DeclarationLA#scan :
   [Modifiers]
   ( "class" | "fun" | "interface" | "object" | "val" | "var" | "typealias")
;

Declaration :
  SCAN DeclarationLA =>
  (
    ClassDeclaration
    |
    ObjectDeclaration
    |
    FunctionDeclaration
    |
    PropertyDeclaration
    |
    TypeAlias
  )
;

ClassDeclaration :
   {boolean isEnum = false;}
   [Modifiers {isEnum = peekNode().firstChildOfType(TokenType.ENUM)!= null;}]
   (
      "class"
      |
      ["fun"] "interface" =>||
   )
   =>||
   <IDENTIFIER>
   [TypeParameters]
   [PrimaryConstructor]
   [":" DelegationSpecifiers]
   [TypeConstraints]
   (
      SCAN 0 {isEnum} => EnumClassBody
      |
      ClassBody
   )
;

ObjectDeclaration :
    [Modifiers]
    "object" =>||
    <IDENTIFIER>
    ":"
    Type
;

FunctionDeclaration :
   [Modifiers]
   "fun" =>||
   [TypeParameters]
   [ReceiverType "." =>||]
   <IDENTIFIER>
   FunctionValueParameters
   [":" Type]
   [TypeConstraints]
   [FunctionBody]
;

FunctionBody : Block | "=" Expression ;

Modifiers# :
   Annotation
   |
   Modifier (Annotation|Modifier)*
;

Modifier#void :
   'enum' | 'sealed' | 'annotation' | 'data' | 'inner' | 'value' |
   'override' | 'lateinit' | 'public' | 'private' | 'internal' | 'protected' |
   'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'suspend' |
   'const' | 'abstract' | 'final' | 'open' | 'vararg' | 'noinline' | 'crossinline' |
   'expect' | 'actual'
;

TypeAlias :
   [Modifiers] "typealias" =>||
   <IDENTIFIER>
   [TypeParameters]
   "="
   Type
;

PrimaryConstructor : [Modifiers] 'constructor' ClassParameters ;

ClassParameters :
    "("
    [
        ClassParameter
        ("," =>|+1 ClassParameter)* [","]
    ]
    ")"
;

ClassParameter :
   [Modifiers]
   ["val"|"var"]
   <IDENTIFIER>
   ":"
   Type
   ["=" Expression]
;

PropertyDeclaration :
  [Modifiers]
  ("val"|"var")
  =>||
  [TypeParameters]
  [ReceiverType "." =>||]
  (MultiVariableDeclaration | VariableDeclaration)
  [TypeConstraints]
  [
    "=" Expression
    |
    PropertyDelegate
  ]
  [","]
  (
    [
        Getter [[Semis] Setter]
        |
        Setter [[Semis] Getter]
    ]
  )
;

Getter :
   [Modifiers]
   'get' =>||
   [
      "(" ")"
      [":" Type]
      FunctionBody
   ]
;

Setter :
   [Modifiers]
   'set' =>||
   [
      "("
      FunctionValueParameterWithOptionalType [","]
      ")"
      [":" Type]
      FunctionBody
   ]
;

TypeParameters :
   "<"
   TypeParameter
   ("," =>|+1 TypeParameter)* [","]
   ">"
;

TypeParameter :
   TypeParameterModifiers
   <IDENTIFIER>
   [":" Type]
;

TypeConstraints : 'where' TypeConstraint ("," TypeConstraint)* ;

TypeConstraint : (Annotation)* <IDENTIFIER> ":" Type ;

TypeParameterModifiers# : ('reified' | "in" | 'out' | Annotation)* ;

ClassBody : "{" ClassMemberDeclarations "}" ;

// TODO: Disambiguate this from a ClassBody?
EnumClassBody : "{" [EnumEntries] [";" ClassMemberDeclarations]"}" ;

// TODO: Deal with the lhs being assignable
Assignment : Expression AssignmentOperator =>|| Expression ;

AssignmentOperator#void : "=" | "+=" | "-=" | "*=" | "/=" | "%=" ;

DelegationSpecifiers : AnnotatedDelegationSpecifier ("," AnnotatedDelegationSpecifier)* ;

AnnotatedDelegationSpecifier : (Annotation)* DelegationSpecifier ;

DelegationSpecifier :
   ConstructorInvocation
   |
   ExplicitDelegation
   |
   UserType
   |
   FunctionType
   |
   'suspend' FunctionType
;

PropertyDelegate : 'by' Expression ;

ExplicitDelegation :
   (UserType | FunctionType)
   'by' =>||
   Expression
;

ClassMemberDeclarations : (ClassMemberDeclaration [Semis])* ;

ClassMemberDeclaration :
   Declaration
   |
   CompanionObject
   |
   AnonymousInitializer
   |
   SecondaryConstructor
;


AnonymousInitializer : 'init' Block ;

CompanionObject :
    [Modifiers]
    'companion' =>||
    ['data']
    "object"
    [<IDENTIFIER>]
    [":" DelegationSpecifiers]
    [ClassBody]
;


SecondaryConstructor :
   [Modifiers]
   'constructor' =>||
   FunctionValueParameters
   [":" ConstructorDelegationCall]
   [Block]
;

ConstructorDelegationCall : ("this"|"super") ValueArguments ;

FunctionValueParameters :
   "("
   [FunctionValueParameter ("," =>|+1 FunctionValueParameter)* [","]]
   ")"
;

FunctionValueParameter : [ParameterModifiers] Parameter ["=" Expression] ;

ParameterModifiers :
    Annotation
    |
    ParameterModifier (Annotation|ParameterModifier)*
;

ParameterModifier#void : 'vararg' | 'noinline' | 'crossinline' ;

FunctionValueParameterWithOptionalType :
   [ParameterModifiers]
   ParameterWithOptionalType
   ["=" Expression]
;

ParameterWithOptionalType : <IDENTIFIER> [":" Type] ;

EnumEntries : EnumEntry ("," =>|+1 EnumEntry)* [","] ;

EnumEntry : [Modifiers] <IDENTIFIER> [ValueArguments] [ClassBody] ;

PrimaryExpression :
   <IDENTIFIER>
   |
   LiteralConstant
   |
   StringLiteral
   |
   CallableReference
   |
   ParenthesizedExpression
   |
   LambdaLiteral
   |
   AnonymousFunction
   |
   ObjectLiteral
   |
   CollectionLiteral
   |
   ThisExpression
   |
   SuperExpression
   |
   IfExpression
   |
   WhenExpression
   |
   TryExpression
   |
   ThrowExpression
   |
   ReturnExpression
   |
   ContinueExpression
   |
   BreakExpression
;

ParenthesizedExpression : "(" Expression ")" ;

LiteralConstant#void :
   "true" | "false" | "null" |
   <INTEGER_LITERAL> | <HEX_LITERAL> | <BIN_LITERAL> |
   <CHARACTER_LITERAL> | <FLOAT_LITERAL> | <DOUBLE_LITERAL> |
   <LONG_LITERAL> | <UNSIGNED_LITERAL>
;

CallableReference : [ReceiverType] "::" =>|| (<IDENTIFIER> | "class") ;

ObjectLiteral :
   ['data']
   "object"
   [":" DelegationSpecifiers]
   [ClassBody]
;

WhenExpression :
   "when"
   [WhenSubject]
   "{"
   (WhenEntry)*
   "}"
;

WhenEntry :
   WhenCondition ("," =>|+1 WhenCondition)* [","]
   "->" ControlStructureBody [Semis]
   |
   "else" "->" ControlStructureBody [Semis]
;

WhenCondition :
   Expression
   |
   RangeTest
   |
   TypeTest
;

TypeTest : IsOperator Type ;

RangeTest : InOperator Expression ;

WhenSubject :
    "("
       [
         (Annotation)*
         "val"
         VariableDeclaration
         "="
       ]
       Expression
    ")"
;

ThisExpression : "this" | <THIS_AT> ;

SuperExpression :
    <SUPER_AT>
    |
    // TODO: Look at whitespace
    "super" ["<" Type ">"] "@" <IDENTIFIER>
;

AnonymousFunction :
   ['suspend']
   "fun" =>||
   [Type "."]
   ParameterWithOptionalType
   [":" Type]
   [TypeConstraints]
   [FunctionBody]
;

IfExpression :
   "if"
   "("
   Expression
   ")"
   (ControlStructureBody | ";")
   [
      "else"
      (ControlStructureBody | ";")
   ]
;

CollectionLiteral :
   "["
   [
        Expression
        ("," =>|+1 Expression)*
        [","]
   ]
   "]"
;

TryExpression :
    {boolean hasCatch = false, hasFinally = false;}
    "try" Block
    (CatchBlock {hasCatch = true;})*
    [FinallyBlock {hasFinally = true;}]
    ASSERT {hasCatch | hasFinally : "There must be at least one catch or finally block."}
;

CatchBlock :
   'catch'
   "("
   (Annotation)*
   <IDENTIFIER>
   ":"
   Type
   [","]
   ")"
   Block
;

FinallyBlock : 'finally' Block ;

ThrowExpression : "throw" Expression ;

ReturnExpression : <RETURN_AT> | "return" Expression ;

ContinueExpression : <CONTINUE_AT> | "continue" ;

BreakExpression : <BREAK_AT> | "break" ;

// TODO: interpolations, etc.
StringLiteral# : <STRING_LITERAL> ;

INJECT StringLiteral : implements Expression

