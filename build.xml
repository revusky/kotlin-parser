<project name="kotlin-parser" default="compile">
    <target name="init">
        <uptodate property="parser.uptodate"
            targetfile="build/org/parsers/kotlin/KotlinParser.java">
            <srcfiles dir="." includes="*.ccc" />
        </uptodate>
    </target>

    <target name="clean">
        <delete dir="build" />
    </target>

    <target name="build-parser" depends="init" unless="parser.uptodate">
        <echo>Generating the parser...</echo>
        <java fork="true" jar="bin/congocc.jar" failonerror="true">
            <assertions>
                <enable />
            </assertions>
            <arg line="-n -q -d build Kotlin.ccc" />
        </java>
    </target>

    <target name="compile" depends="build-parser">
        <!--copy file="KParse.java" todir="build" / -->
        <javac destdir="build"
            deprecation="off"
            debug="on"
            optimize="off"
            failonerror="true"
            includeantruntime="false"
            release="8">
            <src path="build" />
        </javac>
        <javac includes="KParse.java"
               srcdir="."
               destdir="build"
               classpath="build"
               includeantruntime="false"
               release="8"
        />
    </target>

    <target name="test" depends="compile">
        <java fork="true"
              classpath="build"
              failonerror="true"
              classname="KParse" >
            <assertions>
                <enable />
            </assertions>
            <arg value="testfiles" />
        </java>
    </target>
</project>