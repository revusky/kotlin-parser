DEFAULT_LEXICAL_STATE=KOTLIN;
DEACTIVATE_TOKENS = SHEBANG;
TAB_SIZE=4;
ENSURE_FINAL_EOL;
PARSER_PACKAGE=org.parsers.kotlin;

INCLUDE "KotlinLexer.ccc"

KotlinFile :
  ACTIVATE_TOKENS SHEBANG [<SHEBANG>]
  NLs
  (FileAnnotation)*
  [PackageDeclaration]
  (ImportDeclaration)*
  (SCAN ~(<EOF>) => TopLevelObject)*
  <EOF>
;

TopLevelObject : Declaration [Semis] ;

DottedName : <IDENTIFIER> ("." <IDENTIFIER> =>||)* ;

NLs#void : (<NL> {popNode();})* ;

FileAnnotation :
   "@"
   ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))}
   'file'
   =>||
   NLs ":" NLs
    (
        "[" (UnescapedAnnotation)+ "]"
        |
        UnescapedAnnotation
    )
    NLs
;

PackageDeclaration : "package" DottedName Semis ;

ImportDeclaration :
    'import'
    DottedName
    [
        "." "*"
        |
        "as" <IDENTIFIER>
    ]
    Semis
;

UnescapedAnnotation :
    UserType
    [
      // Somewhat kludgy. REVISIT
      ENSURE (ValueArguments ENSURE ~("->"))
      ValueArguments #ConstructorInvocation(2)
    ]
;

ConstructorInvocation : UserType NLs =>|+1 ValueArguments;

UserType :
    SimpleUserType
    (
// The following cases are really a bit kludgy. REVISIT
      ENSURE \...\TypeArguments
      NLs "." NLs =>|+1 SimpleUserType
      |
      ENSURE ~\...\ReceiverType
      NLs "." NLs =>|+1 SimpleUserType
      |
      ENSURE \...\ReceiverType
      NLs "." NLs SimpleUserType ENSURE (("?")* ".") =>||
    )*
;

SimpleUserType : <IDENTIFIER> [NLs =>|+1 TypeArguments] ;

ValueArguments :
   "("
   NLs
   [
      ValueArgument
      (NLs "," NLs =>|+1 ValueArgument)* [NLs "," =>||]
      NLs
   ]
   ")"
;

ValueArgument :
   [Annotation]
   NLs
   [<IDENTIFIER> NLs "=" =>|| NLs]
   ["*"]
   NLs
   Expression
;

TypeArguments :
   "<"
   NLs
   TypeProjection
   (NLs "," =>|+1 NLs TypeProjection)*
   [NLs "," =>||]
   NLs
   ">"
;

TypeProjection :
    "*"
    |
    TypeProjectionModifiers Type
;

TypeProjectionModifiers :
   ("in" NLs | 'out' NLs | Annotation)*
;

Annotation :
   (
    AnnotationUseSiteTarget
    |
    "@"
    ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))} =>||
   )
   (
      UnescapedAnnotation
      |
      "[" (UnescapedAnnotation)+ "]"
   )
   NLs
;

AnnotationUseSiteTarget :
    "@"
    ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))}
    ('field' | 'property' | 'get' | 'set' | 'receiver' | 'param' | 'setparam' | 'delegate')
    =>||
    ":"
;

Type :
   [TypeModifiers]
   (
     FunctionType
     |
     DefinitelyNonNullableType
     |
     NullableType
   )
;

TypeModifiers :
   ('suspend' | Annotation)+
;

ParenthesizedType : "(" NLs Type NLs ")" ;

FunctionType :
   [ReceiverType NLs "." =>|| NLs]
   FunctionTypeParameters
   NLs
   "->" =>||
   NLs
   Type
;

ReceiverType# :
   [TypeModifiers]
   NullableType
;

NullableType :
   (TypeReference | ParenthesizedType)
   NLs
   ("?")*
;

TypeReference : 'dynamic' | UserType ;

DefinitelyNonNullableType :
   [TypeModifiers]
   (UserType | ParenthesizedUserType)
   NLs
   "&" =>||
   NLs
   [TypeModifiers]
   (UserType | ParenthesizedUserType)
;

ParenthesizedUserType :
    "("
    NLs
    (UserType | ParenthesizedUserType)
    NLs
    ")"
;

FunctionTypeParameters :
    "("
    NLs
    [Parameter|Type]
    (NLs "," NLs =>|+1 (Parameter | Type))*
    [NLs "," =>||]
    NLs
    ")"
;

Parameter : <IDENTIFIER> NLs ":" =>|| NLs [ContextParameters] Type ;

ContextParameters :
  'context'
  "("
      [<IDENTIFIER> NLs ":" NLs =>||] Type
      ("," [<IDENTIFIER> NLs ":" NLs =>||] Type)*
  ")"
;

ExpressionNoLambda#void :
   Expression
;

#Expression#interface :
   Disjunction
/*
   {
      if (!(peekNode() instanceof Expression)) {
          System.out.println(peekNode().getType());
          System.out.println(peekNode());
      }
   }*/
   {return (Expression) peekNode();}
;

INJECT Disjunction : implements Expression
INJECT Conjunction : implements Expression
INJECT Equality : implements Expression
INJECT Comparison : implements Expression
INJECT GenericCallLikeComparison : implements Expression
INJECT InfixOperation : implements Expression
INJECT ElvisExpression : implements Expression
INJECT PostfixUnaryExpression : implements Expression
INJECT InfixFunctionCall : implements Expression
INJECT ElvisExpression : implements Expression
INJECT AdditiveExpression : implements Expression
INJECT MultiplicativeExpression : implements Expression
INJECT AsExpression : implements Expression
INJECT PrefixUnaryExpression : implements Expression
INJECT RangeExpression : implements Expression
INJECT ParenthesizedExpression : implements Expression

INJECT PrimaryExpression : extends Expression
INJECT IfExpression : implements PrimaryExpression
INJECT ReturnExpression : implements PrimaryExpression
INJECT ThrowExpression : implements PrimaryExpression
INJECT TryExpression : implements PrimaryExpression
INJECT WhenExpression : implements PrimaryExpression
INJECT ObjectLiteral : implements PrimaryExpression
INJECT ThisExpression : implements PrimaryExpression
INJECT ContinueExpression : implements PrimaryExpression
INJECT BreakExpression : implements PrimaryExpression
INJECT CallableReference : implements PrimaryExpression
INJECT LambdaLiteral : implements PrimaryExpression
INJECT CollectionLiteral : implements PrimaryExpression
INJECT AnonymousFunction : implements PrimaryExpression

Disjunction : Conjunction (NLs "||" =>|| NLs Conjunction)* ;

Conjunction : Equality (NLs "&&" =>|| NLs Equality)* ;

Equality : Comparison (EqualityOperator NLs Comparison)* ;

Comparison :
    GenericCallLikeComparison
    (ComparisonOperator NLs GenericCallLikeComparison)*
;

GenericCallLikeComparison :
    InfixOperation
    (
      ENSURE ("{")
      ENSURE ~\...\ExpressionNoLambda
      CallSuffix
      |
      ENSURE ("(")
      CallSuffix
    )*
;

InfixOperation :
   ElvisExpression
   (
      InOperator NLs ElvisExpression
      |
      IsOperator NLs Type
   )*
;

ElvisExpression :
    InfixFunctionCall
    (NLs "?:" =>|| NLs InfixFunctionCall)*
;

InfixFunctionCall :
    RangeExpression
    (
      ENSURE {peekNode() != null && peekNode().getEndLine() == getToken(1).getBeginLine()}
      <IDENTIFIER>
      NLs
      RangeExpression
   )*
;

RangeExpression : AdditiveExpression ((".." | "..<") NLs AdditiveExpression)* ;

AdditiveExpression : MultiplicativeExpression (("+"|"-") NLs MultiplicativeExpression)* ;

MultiplicativeExpression : AsExpression (("*"|"/"|"%") NLs AsExpression)* ;

AsExpression : PrefixUnaryExpression (NLs ("as"|"as?") =>|| NLs Type)* ;

PrefixUnaryExpression :
    (ENSURE {getTokenType(1) != IDENTIFIER || getTokenType(2) == AT} UnaryPrefix)*
    PostfixUnaryExpression
;

UnaryPrefix#void : Label | Annotation | PrefixUnaryOperator NLs ;

PrefixUnaryOperator#void : "++" | "--" | "-" | "+" | "!" ;

PostfixUnaryExpression : PrimaryExpression (PostfixUnarySuffix)* ;

EqualityOperator#void : "!=" | "!==" | "==" | "===" ;

ComparisonOperator#void : "<" | "<=" | ">=" | ">" ;

InOperator#void : "in" | "!in" ;

IsOperator#void : "is" | "!is";

Label :
   <IDENTIFIER>
   ENSURE { !Character.isWhitespace(getToken(1).charAt(-1)) }
   "@" =>||
   NLs
;

PostfixUnarySuffixLA#scan :
   "++" | "--" | "!"|"["|"::" | "("
   |
   NLs "." =>||
   |
   NLs "?" "."
   ENSURE {getToken(-1).getEndOffset() == getToken(0).getBeginOffset()}
   |
   ENSURE ~\...\ExpressionNoLambda
   [Label]
   "{"
   |
   //REVISIT
   TypeArguments
;

PostfixUnarySuffix#void :
  SCAN PostfixUnarySuffixLA =>
  (
    PostfixUnaryOperator
    |
    NavigationSuffix
    |
    CallSuffix
    |
    TypeArguments
    |
    IndexingSuffix
  )
;

PostfixUnaryOperator#void : "++" | "--" | "!" ;

NavigationSuffix :
    NLs
    MemberAccessOperator
    NLs =>||
    (<IDENTIFIER> | ParenthesizedExpression | "class")
;

IndexingSuffix :
    "["
    NLs
    Expression
    (NLs "," NLs =>|+1 Expression)*
    [NLs "," =>||]
    NLs
    "]"
;

CallSuffix :
    [TypeArguments]
    ENSURE ("(" | (Annotation)* [Label=>||] "{" )
    =>||
    (
        ValueArguments [ENSURE ~\...\ExpressionNoLambda AnnotatedLambda]
        |
        ENSURE ~\...\ExpressionNoLambda
        AnnotatedLambda
    )
;

MemberAccessOperator :
   (
      "."
      |
      "::"
      |
      "?" "."
   )
;

AnnotatedLambda : (Annotation)* [Label] NLs =>|+1 LambdaLiteral ;

LambdaLiteral :
    "{"
    NLs
    [
        [LambdaParameters]
        NLs
        "->"
        =>||
        NLs
    ]
    (
       SCAN ~([Semis] "}") =>
       [Semis]
       Statement
    )*
    NLs
    "}"
;

LambdaParameters :
   LambdaParameter (NLs "," =>|+1 NLs LambdaParameter)* [NLs "," =>||]
;

LambdaParameter :
   MultiVariableDeclaration [NLs ":" =>|| NLs Type]
   |
   VariableDeclaration
   |
   "_" [NLs ":" =>|| NLs Type]
;

VariableDeclaration : (Annotation)* NLs <IDENTIFIER> [NLs ":" =>|| NLs Type] ;

MultiVariableDeclaration :
    "("
    NLs
    (
      "_" [NLs ":" =>|| NLs Type]
      |
      VariableDeclaration
    )
    (
      NLs
      ","
      NLs =>|+1
      (
         "_" [NLs ":" =>|| NLs Type]
         |
         VariableDeclaration
      )
    )*
    [NLs "," =>||]
    NLs
    ")"
;

DestructuringVariableDeclaration :
    "["
    NLs
    DestructuringEntry
    (NLs "," NLs =>|+1 DestructuringEntry)*
    [NLs "," =>||]
    NLs
    "]"
;

DestructuringEntry : "_" | <IDENTIFIER> NLs [":" NLs Type] ;

Semis :
   (";" | <NL>)+
;

Semi :
   (";"|<NL>)
   NLs
;

Statement :
   (Label|Annotation)*
   (
    ForStatement
    |
    WhileStatement
    |
    DoWhileStatement
    |
    FunctionDeclaration
    |
    Assignment
    |
    Declaration
   )
;

ForStatement :
   "for"
   NLs
   "("
   (Annotation)*
   (
      MultiVariableDeclaration
      |
      DestructuringVariableDeclaration
      |
      VariableDeclaration
   )
   "in"
   Expression
   ")"
   NLs
   [ControlStructureBody]
;

WhileStatement :
    "while"
    NLs
    "("
    Expression
    ")"
    NLs
    (ControlStructureBody | ";")
;

DoWhileStatement :
   "do"
   NLs
   [ControlStructureBody]
   NLs
   "while"
   NLs
   "("
   Expression
   ")"
;

ControlStructureBody#void : Block | Statement ;

Block :
   "{"
     (
       SCAN ~([Semis] "}") =>
       [Semis]
       Statement
     )*
   [Semis]
   "}"
;

Declaration :
    TypeAlias
    |
    ClassDeclaration
    |
    ObjectDeclaration
    |
    FunctionDeclaration
    |
    PropertyDeclaration
;

ClassDeclaration :
   {boolean isEnum = false;}
   [Modifiers {isEnum = peekNode().firstChildOfType(TokenType.ENUM)!= null;}]
   (
      "class"
      |
      ["fun"] "interface" =>||
   )
   =>||
   NLs
   <IDENTIFIER>
   [NLs =>|+1 TypeParameters]
   [
      NLs
      ENSURE
      (
         [[Modifiers] 'constructor' NLs] "("
      )
      =>||
      PrimaryConstructor
   ]
   [NLs ":" =>|| DelegationSpecifiers]
   [NLs =>|+1 TypeConstraints]
   [
      SCAN (NLs "{") =>
      (
         SCAN 0 {isEnum} => NLs EnumClassBody
         |
         SCAN 0 NLs ClassBody
      )
   ]
;

ObjectDeclaration :
    [Modifiers]
    "object"
    NLs
    <IDENTIFIER> =>||
    [NLs ":" =>|| NLs DelegationSpecifiers]
    [NLs =>|+1 ClassBody]
;

FunctionDeclaration :
   [ContextParameters NLs] // Very bleeding edge
   [Modifiers]
   "fun" =>||
   [NLs =>|+1 TypeParameters]
   [NLs ReceiverType NLs "." =>||]
   NLs
   <IDENTIFIER>
   NLs
   FunctionValueParameters
   [NLs ":" =>|| NLs Type]
   [NLs =>|+1 TypeConstraints]
   [NLs =>|+1 FunctionBody]
;

FunctionBody : Block | "=" NLs Expression ;

Modifiers# :
   ENSURE ~(Modifier ":")
   (Modifier|Annotation)+
;

Modifier#void :
   'enum' | 'sealed' | 'annotation' | 'data' | 'inner' | 'value' |
   'override' | 'lateinit' | 'public' | 'private' | 'internal' | 'protected' |
   'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'suspend' |
   'const' | 'abstract' | 'final' | 'open' | 'vararg' | 'noinline' | 'crossinline' |
   'expect' | 'actual'
;

TypeAlias :
   [Modifiers] "typealias" =>||
   NLs
   <IDENTIFIER>
   [NLs =>|+1 TypeParameters]
   NLs
   "="
   NLs
   Type
;

PrimaryConstructor : [[Modifiers] 'constructor' NLs] ClassParameters ;

ClassParameters :
    "("
    NLs
    [
        ClassParameter
        (NLs "," NLs =>|+1 ClassParameter)* [NLs "," =>||]
    ]
    NLs
    ")"
;

ClassParameter :
   [Modifiers]
   ["val"|"var"]
   NLs
   <IDENTIFIER>
   ":"
   NLs
   Type
   [NLs "=" =>|| NLs Expression]
;

PropertyDeclaration :
  [Modifiers]
  ("val"|"var")
  =>||
  [NLs =>|+1 TypeParameters]
  [NLs ReceiverType NLs "." =>||]
  (NLs (MultiVariableDeclaration | VariableDeclaration))
  [NLs =>|+1 TypeConstraints]
  [
   NLs =>|+1
   (
    "=" NLs Expression
    |
    PropertyDelegate
   )
  ]
// [NLs ";" =>||]
  [
     NLs
     ENSURE ([";"] [Modifiers] ('get'|'set') ENSURE ~(MemberAccessOperator))
     =>||
     (
        Getter [NLs [Semi] ENSURE ([Modifiers] 'set') =>|| Setter]
        |
        Setter [NLs [Semi] ENSURE ([Modifiers] 'get') =>|| Getter]
        |
        Semi (Getter|Setter)
     )
  ]
;

Getter :
   [Modifiers]
   'get' =>||
   [
      NLs
      "(" =>||
      NLs
      ")"
      [NLs ":" =>|| NLs Type]
      NLs
      FunctionBody
   ]
;

Setter :
   [Modifiers]
   'set' =>||
   [
      NLs
      "(" =>||
      NLs
      FunctionValueParameterWithOptionalType [NLs "," =>||]
      NLs
      ")"
      [NLs ":" =>|| NLs Type]
      NLs
      FunctionBody
   ]
;

TypeParameters :
   "<"
   NLs
   TypeParameter
   (NLs "," NLs =>|+1 TypeParameter)* [NLs "," =>||]
   NLs
   ">"
;

TypeParameter :
   TypeParameterModifiers
   NLs
   <IDENTIFIER>
   [NLs ":" =>|| NLs Type]
;

TypeConstraints : 'where' NLs TypeConstraint (NLs "," =>|| NLs TypeConstraint)* ;

TypeConstraint : (Annotation)* <IDENTIFIER> NLs ":" NLs Type ;

TypeParameterModifiers# : ('reified' | "in" | 'out' | Annotation)* ;

ClassBody : "{" NLs ClassMemberDeclarations NLs "}" ;

// TODO: Disambiguate this from a ClassBody?
EnumClassBody :
    "{"
    NLs
    [EnumEntries]
    [NLs ";" =>|| NLs ClassMemberDeclarations]
    NLs
    "}"
;

// TODO: Deal with the lhs being assignable
Assignment :
    Expression
    [
       AssignmentOperator
       NLs
       Expression
    ]
;

AssignmentOperator#void : "=" | "+=" | "-=" | "*=" | "/=" | "%=" ;

DelegationSpecifiers :
    AnnotatedDelegationSpecifier
    (NLs "," =>|| NLs AnnotatedDelegationSpecifier)*
;

AnnotatedDelegationSpecifier : (Annotation)* NLs DelegationSpecifier ;

DelegationSpecifier :
   ConstructorInvocation
   |
   ExplicitDelegation
   |
   UserType
   |
   FunctionType
   |
   'suspend' NLs FunctionType
;

PropertyDelegate : 'by' NLs Expression ;

ExplicitDelegation :
   (UserType | FunctionType)
   NLs
   'by' =>||
   NLs
   //Expression
   ExpressionNoLambda
;

ClassMemberDeclarations : (ClassMemberDeclaration [Semis])* ;

ClassMemberDeclaration :
   CompanionObject
   |
   AnonymousInitializer
   |
   SecondaryConstructor
   |
   Declaration
;

AnonymousInitializer : 'init' NLs Block ;

CompanionObject :
    [Modifiers]
    'companion' =>||
    NLs
    ['data']
    NLs
    "object"
    [NLs <IDENTIFIER> =>||]
    [NLs ":" =>|| NLs DelegationSpecifiers]
    [NLs =>|+1 ClassBody]
;

SecondaryConstructor :
   [Modifiers]
   'constructor' =>||
   NLs
   FunctionValueParameters
   [NLs ":" =>|| NLs ConstructorDelegationCall]
   NLs
   [Block]
;

ConstructorDelegationCall : ("this"|"super") NLs ValueArguments ;

FunctionValueParameters :
   "("
   NLs
   [
      FunctionValueParameter
      (NLs "," NLs =>|+1 FunctionValueParameter)*
      [NLs "," =>||]
   ]
   NLs
   ")"
;

FunctionValueParameter :
    [ParameterModifiers]
    Parameter
    [NLs "=" =>|| NLs Expression]
;

ParameterModifiers :
    (Annotation|ParameterModifier)+
;

ParameterModifier#void : 'vararg' | 'noinline' | 'crossinline' ;

FunctionValueParameterWithOptionalType :
   [ParameterModifiers]
   ParameterWithOptionalType
   [NLs "=" =>|| NLs Expression]
;

ParameterWithOptionalType : <IDENTIFIER> NLs [":" NLs Type] ;

EnumEntries : EnumEntry =>|| (NLs "," NLs =>|+1 EnumEntry)* NLs [","] ;

EnumEntry :
   [Modifiers NLs]
   <IDENTIFIER>
   [NLs =>|+1 ValueArguments]
   [NLs =>|+1 ClassBody]
;

PrimaryExpression#interface :
   <IDENTIFIER>
   |
   LiteralConstant
   |
   StringLiteral
   |
   CallableReference
   |
   ParenthesizedExpression
   |
   LambdaLiteral
   |
   AnonymousFunction
   |
   ObjectLiteral
   |
   CollectionLiteral
   |
   ThisExpression
   |
   SuperExpression
   |
   IfExpression
   |
   WhenExpression
   |
   TryExpression
   |
   ThrowExpression
   |
   ReturnExpression
   |
   ContinueExpression
   |
   BreakExpression
;

ParenthesizedExpression : "(" NLs Expression NLs ")" ;

LiteralConstant#void :
   "true" | "false" | "null" |
   <INTEGER_LITERAL> | <HEX_LITERAL> | <BIN_LITERAL> |
   <CHARACTER_LITERAL> | <FLOAT_LITERAL> | <DOUBLE_LITERAL> |
   <LONG_LITERAL> | <UNSIGNED_LITERAL>
;

CallableReference :
   [([TypeModifiers] NullableType) #ReceiverType]
   "::" =>||
   NLs
   (<IDENTIFIER> | "class")
;

ObjectLiteral# :
   ['data']
   NLs
   "object" =>||
   [NLs ":" =>|| NLs DelegationSpecifiers NLs]
   [NLs =>|+1 ClassBody]
;

WhenExpression :
   "when"
   NLs
   [WhenSubject]
   NLs
   "{"
   NLs
   (WhenEntry NLs)*
   NLs
   "}"
;

WhenEntry :
   WhenCondition
   [NLs "if" =>||
      Expression
      ASSERT {getTokenType(1) != COMMA :
             "Cannot have a guard condition in a comma-separated when entry"}
   ]
   (NLs "," =>|+1 NLs WhenCondition)*
   [NLs "," =>||]
   NLs "->" NLs ControlStructureBody [Semis]
   |
   "else" NLs "->" NLs ControlStructureBody [Semis]
;

WhenCondition:
   Expression
   |
   RangeTest
   |
   TypeTest
;

TypeTest : IsOperator NLs Type ;

RangeTest : InOperator NLs Expression ;

WhenSubject :
    "("
       [
         (Annotation)*
         NLs
         "val"
         NLs
         VariableDeclaration
         NLs
         "="
         NLs
       ]
       Expression
       NLs
    ")"
;

ThisExpression# : "this" | <THIS_AT> ;

SuperExpression :
    <SUPER_AT>
    |
    "super" ["<" NLs Type NLs ">"]
    [
      ENSURE {
         !Character.isWhitespace(getToken(1).charAt(-1))
         && !Character.isWhitespace(getToken(1).charAt(1))
      }
      "@"
      <IDENTIFIER>
    ]
;

AnonymousFunction :
   ['suspend']
   NLs
   "fun"
   =>||
   [NLs Type NLs "." =>||]
   NLs
   ParametersWithOptionalType
   [NLs ":" =>|| NLs Type]
   [NLs =>|+1 TypeConstraints]
   [NLs =>|+1 FunctionBody]
;

ParametersWithOptionalType :
  "("
  NLs
  FunctionValueParameterWithOptionalType
  (NLs "," NLs =>|+1 FunctionValueParameterWithOptionalType)*
  [NLs "," =>|| NLs]
  NLs
  ")"
;

IfExpression :
   "if"
   NLs
   "("
   NLs
   Expression
   NLs
   ")"
   NLs
   (ControlStructureBody | ";")
   NLs
   [
      ENSURE {getTokenType(2) != ARROW}
      "else"
      NLs
      (ControlStructureBody | ";")
   ]
;

CollectionLiteral :
   "["
   NLs
   [
        Expression
        (NLs "," NLs =>|+1 Expression)*
        [NLs "," =>||]
        NLs
   ]
   "]"
;

TryExpression :
    {boolean hasCatch = false, hasFinally = false;}
    "try" NLs Block
    (NLs =>|+1 CatchBlock {hasCatch = true;})*
    [NLs =>|+1 FinallyBlock {hasFinally = true;}]
    ASSERT {hasCatch | hasFinally : "There must be at least one catch or finally block."}
;

CatchBlock :
   'catch'
   NLs
   "("
   (Annotation)*
   ("_"|<IDENTIFIER>)
   ":"
   Type
   [NLs "," =>||]
   ")"
   NLs
   Block
;

FinallyBlock : 'finally' NLs Block ;

ThrowExpression : "throw" NLs Expression ;

ReturnExpression# :
    (
      <RETURN_AT>
      |
      "return"
    )
    [
      ENSURE ~(";"|<NL>)
      Expression
    ]
;

ContinueExpression# : <CONTINUE_AT> | "continue" ;

BreakExpression# : <BREAK_AT> | "break" ;

StringLiteral# :
    LineStringLiteral
    |
    MultilineStringLiteral
;

LineStringLiteral :
    '"'
    LEXICAL_STATE IN_REGULAR_STRING
    (<LINE_STRING_CONTENT>|LineStrExpression)*
    '"'
;

MultilineStringLiteral :
  <TRIPLE_QUOTE_OPEN>
  LEXICAL_STATE IN_MULTILINE_STRING
  (
     <MULTI_LINE_TEXT>
     |
     MultilineInterpolation
  )*
  '"""'
;

LineStrExpression :
    <LINE_STR_EXPRESSION_START>
    LEXICAL_STATE KOTLIN (Expression "}")
;

MultilineInterpolation :
   <MULT_LINE_EXPRESSION_START>
   LEXICAL_STATE KOTLIN
   ( Expression "}")
;

INJECT StringLiteral : implements Expression

